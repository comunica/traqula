SELECT ?s ( ( ?doubled * "2"^^<http://www.w3.org/2001/XMLSchema#integer> ) AS ?quadrupled ) WHERE {
  SELECT ?s ( ( COUNT( ?o ) * "2"^^<http://www.w3.org/2001/XMLSchema#integer> ) AS ?doubled ) WHERE {
    ?s <http://ex.org/p> ?o .
  }
  GROUP BY ?s
  HAVING ( ( ( COUNT( ?o ) * "2"^^<http://www.w3.org/2001/XMLSchema#integer> ) * "2"^^<http://www.w3.org/2001/XMLSchema#integer> ) > "4"^^<http://www.w3.org/2001/XMLSchema#integer> )
}