PREFIX : <http://books.example/>
SELECT ( SUM( ?lprice ) AS ?totalPrice ) WHERE {
  ?org <http://books.example/affiliates> ?auth .
  ?auth <http://books.example/writesBook> ?book .
  ?book <http://books.example/price> ?lprice .
}
GROUP BY ?org
HAVING ( SUM( ?lprice ) > "10"^^<http://www.w3.org/2001/XMLSchema#integer> )
ORDER BY ASC ( ?totalPrice )
VALUES ?book {
  <http://books.example/book2>
}