PREFIX dbpedia-owl: <http://dbpedia.org/ontology/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
SELECT * WHERE {
  ?movie <http://dbpedia.org/ontology/starring> _:0 .
  _:0 <http://www.w3.org/2000/01/rdf-schema#label> "Brad Pitt"@en .
  _:0 (^<http://dbpedia.org/ontology/starring>) ?otherMovie .
}