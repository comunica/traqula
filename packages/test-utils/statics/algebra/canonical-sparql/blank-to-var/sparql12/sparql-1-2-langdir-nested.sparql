SELECT ?c ?d ?lit ?s WHERE {
  {
    VALUES ?lit {
      "hello"@en--ltr
      "olleh"@ar--rtl
    }
    ?s <http://example.com/ns#p> <<( <http://example.com/ns#a> <http://example.com/ns#b> "nested"@en--ltr )>> .
    ?g_0 <http://www.w3.org/1999/02/22-rdf-syntax-ns#reifies> <<( ?s <http://example.com/ns#says> "quoted"@en--rtl )>> .
    ?g_0 <http://example.com/ns#certainty> "sure"@en--ltr .
    BIND( CONCAT( "prefix"@en--ltr , STR( ?lit ) ) AS ?c )
    BIND( SAMETERM( ?lit , STRLANGDIR( "x"^^<http://www.w3.org/2001/XMLSchema#string> , "en"^^<http://www.w3.org/2001/XMLSchema#string> , "rtl"^^<http://www.w3.org/2001/XMLSchema#string> ) ) AS ?d )
  }
  FILTER ( ( ( ?lit != "bye"@en--ltr ) && ( ?lit IN ( "hi"@en--ltr , <<( <http://example.com/ns#a> <http://example.com/ns#b> "deep"@ar--rtl )>> ) ) ) )
}