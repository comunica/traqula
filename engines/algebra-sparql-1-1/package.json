{
  "name": "@traqula/algebra-sparql-1-1",
  "type": "module",
  "version": "1.4.0",
  "description": "Convert SPARQL to SPARQL algebra",
  "author": "Jitse De Smet",
  "lsd:module": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/comunica/traqula.git",
    "directory": "engines/algebra-sparql-1-1"
  },
  "bugs": {
    "url": "https://github.com/comunica/traqula/issues"
  },
  "sideEffects": false,
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/esm/lib/index.d.ts",
      "import": "./dist/esm/lib/index.js",
      "require": "./dist/cjs/lib/index.js"
    }
  },
  "main": "dist/esm/lib/index.js",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist/*/lib/**/*.d.ts",
    "dist/*/lib/**/*.js",
    "dist/*/lib/**/*.js.map",
    "dist/cjs/package.json"
  ],
  "scripts": {
    "build": "yarn build:ts && yarn build:cjs",
    "build:ts": "node \"../../node_modules/typescript/bin/tsc\" -b",
    "build:cjs": "node \"../../node_modules/typescript/bin/tsc\" -b tsconfig.cjs.json",
    "spec:base-1-0": "rdf-test-suite dist/cjs/spec/roundTrip.js https://w3c.github.io/rdf-tests/sparql/sparql10/manifest.ttl -c ../../.rdf-test-suite-cache/",
    "spec:base-1-1": "rdf-test-suite dist/cjs/spec/roundTrip.js http://w3c.github.io/rdf-tests/sparql/sparql11/manifest-all.ttl -c ../../.rdf-test-suite-cache/",
    "spec:query": "yarn spec:base-1-1 -- -s http://www.w3.org/TR/sparql11-query/",
    "spec:update": "yarn spec:base-1-1 -- -s http://www.w3.org/TR/sparql11-update/",
    "spec:all": "yarn spec:base-1-0 && yarn spec:base-1-1 && yarn spec:query && yarn spec:update"
  },
  "dependencies": {
    "@traqula/algebra-transformations-1-1": "^1.4.0",
    "@traqula/core": "^1.3.0",
    "@traqula/rules-sparql-1-1": "^1.4.0"
  },
  "devDependencies": {
    "@traqula/generator-sparql-1-1": "^1.4.0",
    "@traqula/parser-sparql-1-1": "^1.4.0",
    "@traqula/test-utils": "^1.4.0",
    "rdf-test-suite": "^2.0.0",
    "sparqlalgebrajs": "^5.0.1",
    "sparqljs": "^3.7.3"
  }
}
